# Supabase Configuration
# Create a free project at https://supabase.com
# Then go to Project Settings > API to find these values
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Reading pipeline for scripts only
# Fill these in .env when you want automatic bilingual article generation
READING_AI_API_KEY=
READING_AI_PROVIDER=deepseek
READING_AI_ENDPOINT=https://api.deepseek.com/chat/completions
READING_AI_MODEL=deepseek-chat
READING_AI_EXTRA_HEADERS_JSON=
READING_GUARDIAN_KEY=
READING_NEWSAPI_KEY=
READING_TARGET_ARTICLE_COUNT=20
READING_GENERATION_HOUR=2
READING_GENERATION_MINUTE=0

# Backend proxy keys (recommended for production)
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
GUARDIAN_API_KEY=
NEWSAPI_KEY=
DEEPL_API_KEY=
DEEPL_API_BASE=https://api-free.deepl.com
PEXELS_API_KEY=
PORT=3001

# Topic wordlist generation
DATAMUSE_ENABLED=false
DATAMUSE_LIMIT=24

# Frontend public runtime config
VITE_VOA_PODCAST_INDEX_URL=https://learningenglish.voanews.com/z/1689/episodes
VITE_VOA_RSS_URL=https://learningenglish.voanews.com/z/1689/episodes
VITE_BBC_6MIN_RSS_URL=https://feeds.npr.org/500005/podcast.xml
